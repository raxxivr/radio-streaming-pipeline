# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Python virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Python build artifacts & bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Test / coverage output ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Linter / type-checker caches ---
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# --- Raw pipeline data (regenerated by scripts/extract.py) ---
data/raw/*
!data/raw/.gitkeep

# --- Logs ---
logs/
*.log
*.log.*

# --- Database dumps and local Postgres data dirs ---
*.dump
*.pgdump
*.backup
*.bak
pgdata/
postgres-data/

# --- Notebooks / local scratch ---
.ipynb_checkpoints/
scratch/
*.tmp
*.temp

# --- IDE / editor settings ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS metadata ---
.DS_Store
Thumbs.db
desktop.ini
