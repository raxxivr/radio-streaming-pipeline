# Copy this file to .env and edit the values for your machine:
#   Copy-Item .env.example .env        (PowerShell)
#   cp .env.example .env               (bash)
#
# .env is gitignored. Only this example file is committed.

# --- PostgreSQL (used by scripts/load.py) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=radio_pipeline
DB_USER=postgres
DB_PASSWORD=change-me

# --- Radio Browser API (used by scripts/extract.py) ---
API_BASE_URL=https://de1.api.radio-browser.info
API_LIMIT=1000
REQUEST_TIMEOUT_SECONDS=30
